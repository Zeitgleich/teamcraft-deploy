# Managed by Ansible (teamcraft-deploy, role teamcraft_sfu). Runs as tc-sfu: the SFU reads its certificate at start only,
# so a renewed certificate (copied by Caddy's export or teamcraft-sfu-cert) restarts it. Running calls reconnect.
[Unit]
Description=Restart the SFU when its certificate changes

[Path]
PathChanged={{ teamcraft_cert_dir }}/sfu.crt

[Install]
WantedBy=default.target
