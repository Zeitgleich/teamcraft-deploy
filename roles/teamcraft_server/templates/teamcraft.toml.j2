{# A TOML value from YAML: strings, numbers, booleans and lists of them (JSON strings are TOML strings). #}
{% macro toml_value(value) %}{% if value is boolean %}{{ value | lower }}{% elif value is number %}{{ value }}{% else %}{{ value | to_json }}{% endif %}{% endmacro %}
{# A table: its plain keys, then its sub-tables ([path.key]), two levels deep (brands.colors.light). #}
{% macro toml_table(path, table) %}
{% for key, value in table.items() if value is not mapping %}
{{ key }} = {{ toml_value(value) }}
{% endfor %}
{% for key, value in table.items() if value is mapping %}

[{{ path }}.{{ key }}]
{% for subkey, subvalue in value.items() if subvalue is not mapping %}
{{ subkey }} = {{ toml_value(subvalue) }}
{% endfor %}
{% for subkey, subvalue in value.items() if subvalue is mapping %}

[{{ path }}.{{ key }}.{{ subkey }}]
{% for leaf, leafvalue in subvalue.items() %}
{{ leaf }} = {{ toml_value(leafvalue) }}
{% endfor %}
{% endfor %}
{% endfor %}
{% endmacro %}
# Managed by Ansible (teamcraft-deploy, role teamcraft_server). Secrets come from podman secrets as
# TEAMCRAFT_* variables. Option reference: teamcraft.example.toml in the TeamCraft repository;
# unset options keep its defaults. Add more with teamcraft_server_extra_config.

[server]
listen_addr = "127.0.0.1:{{ teamcraft_ports.server }}"

[oidc]
issuer = "{{ teamcraft_oidc_issuer }}"
client_id = "{{ teamcraft_oidc_client_id }}"
server_client = "{{ teamcraft_oidc_server_client }}"
{% if teamcraft_oidc_organization_claim | length > 0 %}
organization_claim = "{{ teamcraft_oidc_organization_claim }}"
{% endif %}
{% if teamcraft_server_oidc_jwks_uri | length > 0 %}
jwks_uri = "{{ teamcraft_server_oidc_jwks_uri }}"
{% endif %}

[oidc.roles]
owner = "{{ teamcraft_server_oidc_roles.owner }}"
admin = "{{ teamcraft_server_oidc_roles.admin }}"
member = "{{ teamcraft_server_oidc_roles.member }}"
guest = "{{ teamcraft_server_oidc_roles.guest }}"

[oidc.sync]
is_enabled = {{ teamcraft_server_oidc_sync_enabled | bool | lower }}
{% if teamcraft_server_oidc_admin_url | length > 0 %}
admin_url = "{{ teamcraft_server_oidc_admin_url }}"
{% endif %}

[logging]
filter = "{{ teamcraft_server_log_filter }}"
format = "json"

# Caddy terminates TLS and sets X-Forwarded-For.
[security]
hsts = true
trust_forwarded_for = true

[storage]
endpoint = "{{ teamcraft_s3_endpoint }}"
region = "{{ teamcraft_s3_region }}"
bucket = "{{ teamcraft_s3_bucket }}"
path_style = {{ teamcraft_s3_path_style | bool | lower }}

{% if teamcraft_server_web_enabled %}
[web]
static_dir = "/srv/teamcraft/web"

{% endif %}
{% if teamcraft_brands | length > 0 %}
# Brands (docs/components/branding.md), from teamcraft_brands.
[branding]
{% if teamcraft_server_brand_assets_src | length > 0 %}
assets_dir = "/etc/teamcraft/brands"
{% endif %}
unknown_host = "{{ teamcraft_server_branding_unknown_host }}"
max_asset_bytes = {{ teamcraft_server_branding_max_asset_bytes }}
{% for brand in teamcraft_brands %}

[[brands]]
{{ toml_table('brands', brand) }}{% endfor %}

{% endif %}
[shares]
public_base_url = "https://{{ teamcraft_domain }}"

[calls]
sfu_url = "https://{{ teamcraft_sfu_hostname }}:{{ teamcraft_ports.sfu }}/call"
issuer = "https://{{ teamcraft_domain }}"
signing_key_path = "/run/secrets/call-signing.pem"
sfu_control_url = "http://127.0.0.1:{{ teamcraft_ports.sfu_control }}"

[meetings]
public_base_url = "https://{{ teamcraft_domain }}"
organizer_fallback_address = "{{ teamcraft_mail_from }}"
{% if teamcraft_caldav_calendar_url | length > 0 %}

[meetings.caldav]
calendar_url = "{{ teamcraft_caldav_calendar_url }}"
username = "{{ teamcraft_caldav_username }}"
{% endif %}
{% if teamcraft_smtp_enabled %}

[meetings.smtp]
host = "{{ teamcraft_smtp_host }}"
port = {{ teamcraft_smtp_port }}
security = "{{ teamcraft_smtp_security }}"
username = "{{ teamcraft_smtp_username }}"
from_address = "{{ teamcraft_mail_from }}"
{% endif %}

[mail]
public_base_url = "https://{{ teamcraft_domain }}"
{% if teamcraft_smtp_enabled %}

[mail.smtp]
host = "{{ teamcraft_smtp_host }}"
port = {{ teamcraft_smtp_port }}
security = "{{ teamcraft_smtp_security }}"
username = "{{ teamcraft_smtp_username }}"
from_address = "{{ teamcraft_mail_from }}"
{% endif %}

[push]
vapid_subject = "mailto:{{ teamcraft_admin_email }}"
{% if teamcraft_push_gateway_url | length > 0 %}

# APNs and FCM wake-ups of the store apps go through the publisher's push gateway; the key is the
# podman secret push_gateway_key (TEAMCRAFT_PUSH__GATEWAY__KEY).
[push.gateway]
url = "{{ teamcraft_push_gateway_url }}"
accept_unbound_tokens = {{ teamcraft_push_gateway_accept_unbound_tokens | bool | lower }}
{% endif %}
{% if teamcraft_server_extra_config | length > 0 %}

{{ teamcraft_server_extra_config }}
{% endif %}
