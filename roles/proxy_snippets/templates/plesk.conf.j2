{% import 'nginx-locations.j2' as nginx with context %}
# Managed by Ansible (teamcraft-deploy, role proxy_snippets): Plesk, {{ proxy_site[1] }}
# (docs/proxies/plesk.md). Paste everything below into Websites & Domains > {{ proxy_site[1] }} >
# Apache & nginx Settings > "Additional nginx directives". Works with "Proxy mode" on or off: the
# catch-all is a regex location, which wins over Plesk's own "location /". Turn off "Serve static files
# directly by nginx" for this domain (its regex for .js, .css, .png, ... comes first and would serve them
# from the document root). Plesk adds listen, server_name and the certificate itself.

{% if proxy_site[0] == 'sfu' %}
# The SFU's domain: Plesk keeps answering everything else (and its Let's Encrypt renewals); calls use
# udp/{{ teamcraft_ports.sfu }} with a copy of this domain's certificate.
{% endif %}
{{ nginx.locations(proxy_site[0], proxy_site[1], proxy_site[2], '', plesk=true) }}
{%- if teamcraft_sfu_enabled and proxy_site[1] == teamcraft_proxy_sfu_plesk_domain %}

# {{ teamcraft_sfu_hostname }} is an alias of this domain (teamcraft_proxy_sfu_plesk_domain): its call
# fallback. It answers on this domain's other names as well; only clients given the SFU's URL ask for it.
{{ nginx.locations('sfu', teamcraft_sfu_hostname, teamcraft_ports.sfu_fallback, '', plesk=true) }}
{%- endif %}

