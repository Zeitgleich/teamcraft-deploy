# Managed by Ansible (teamcraft-deploy, role demo_reset). Settings of demo-reset.sh (its header).
# The rclone remote is "demo_s3": older rclone releases map only that form to RCLONE_CONFIG_DEMO_S3_*.
DEMO_DATABASE_URL=postgres://teamcraft@127.0.0.1:{{ teamcraft_ports.postgres }}/{{ teamcraft_db_name }}
DEMO_BUCKET=demo_s3:{{ teamcraft_s3_bucket }}
DEMO_STOP_CMD="systemctl --user -M tc-server@ stop teamcraft-server.service"
DEMO_START_CMD="systemctl --user -M tc-server@ start teamcraft-server.service"
DEMO_READY_URL=http://{{ teamcraft_upstream_host }}:{{ teamcraft_ports.server }}/readyz
DEMO_SEED_DIR={{ demo_reset_seed_dir }}
DEMO_LOG_FILE={{ demo_reset_log_file }}
RCLONE_CONFIG_DEMO_S3_TYPE=s3
RCLONE_CONFIG_DEMO_S3_PROVIDER=Other
RCLONE_CONFIG_DEMO_S3_ENDPOINT=http://{{ teamcraft_upstream_host }}:{{ teamcraft_ports.garage_s3 }}
RCLONE_CONFIG_DEMO_S3_REGION={{ teamcraft_s3_region }}
RCLONE_CONFIG_DEMO_S3_FORCE_PATH_STYLE=true
RCLONE_CONFIG_DEMO_S3_ACCESS_KEY_ID={{ teamcraft_s3_access_key }}
RCLONE_CONFIG_DEMO_S3_SECRET_ACCESS_KEY={{ teamcraft_s3_secret_key }}
