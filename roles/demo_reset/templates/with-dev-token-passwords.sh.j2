#!/usr/bin/env bash
# Managed by Ansible (teamcraft-deploy, role demo_reset). Runs a command with the Dex passwords of
# the seed users in dev/dev-token.py's variables: from systemd's credentials (LoadCredential) when
# there are some, else (as root) from the secrets directory.
set -euo pipefail
dir="${CREDENTIALS_DIRECTORY:-{{ base_secrets_dir }}}"
{% for variable, name in demo_reset_peers_passwords.items() %}
if [[ -r "$dir/dex_password_{{ name }}" ]]; then
  {{ variable }}="$(cat "$dir/dex_password_{{ name }}")"
  export {{ variable }}
fi
{% endfor %}
exec "$@"
