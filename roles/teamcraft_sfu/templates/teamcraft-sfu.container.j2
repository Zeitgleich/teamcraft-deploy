# Managed by Ansible (teamcraft-deploy, role teamcraft_sfu). Runs rootless as tc-sfu.
[Unit]
Description=TeamCraft SFU (WebTransport media forwarding)

[Container]
Image={{ teamcraft_sfu_image }}
Pull=missing
ContainerName=teamcraft-sfu
# Host network: rootless user-mode networking (pasta) adds per-packet overhead that matters for
# media forwarding.
Network=host
# Certificate copied by Caddy's export timer or the root timer for an existing certificate; tc-sfu reads
# it via group tc-certs.
Volume={{ teamcraft_cert_dir }}:/certs:ro
Volume=/home/tc-sfu/config/call-signing.pub.pem:/etc/teamcraft/call-signing.pub.pem:ro,Z
Secret=sfu_registration_token,type=env,target=TEAMCRAFT_SFU_REGISTRATION_TOKEN
# Dual-stack socket: [::] with IPV6_V6ONLY off accepts IPv4 (mapped) and IPv6.
Environment=TEAMCRAFT_SFU_BIND=[::]:{{ teamcraft_ports.sfu }}
# Health and host controls (called by the server): loopback only.
Environment=TEAMCRAFT_SFU_HEALTH_BIND=127.0.0.1:{{ teamcraft_ports.sfu_control }}
# Call fallback (WebSocket over TCP for clients whose network blocks UDP), reached through the proxy at
# wss://{{ teamcraft_sfu_hostname }}/call/fallback. Plain HTTP: on the upstream address only, as the image's
# [::]:8082 would be every address of the host (Network=host).
Environment=TEAMCRAFT_SFU_FALLBACK_BIND={{ teamcraft_upstream_host }}:{{ teamcraft_ports.sfu_fallback }}
{% if not (teamcraft_upstream_address is match('127[.]') or teamcraft_upstream_address == '::1') %}
# The proxy connects from {{ teamcraft_upstream_address }}, not loopback: trust its X-Forwarded-For.
Environment=TEAMCRAFT_SFU_FALLBACK_TRUSTED_PROXIES={{ teamcraft_upstream_address }}
{% endif %}
Environment=TEAMCRAFT_SFU_CERT=/certs/sfu.crt
Environment=TEAMCRAFT_SFU_KEY=/certs/sfu.key
Environment=TEAMCRAFT_SFU_JOIN_TOKEN_PUBLIC_KEY=/etc/teamcraft/call-signing.pub.pem
Environment=TEAMCRAFT_SFU_JOIN_TOKEN_ISSUER=https://{{ teamcraft_domain }}
# Join and leave reports go to the internal API over loopback (the proxy refuses /api/internal/).
Environment=TEAMCRAFT_SFU_SERVER_URL=http://{{ teamcraft_upstream_host }}:{{ teamcraft_ports.server }}
Environment=RUST_LOG={{ teamcraft_sfu_log_filter }}
Environment=NO_COLOR=1
User=65532
Group=65532
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
RunInit=yes
# Exec form (JSON): the distroless image has no shell for the string form.
HealthCmd=["/usr/local/bin/teamcraft-sfu", "healthcheck"]
HealthInterval=30s
# keep-groups: tc-sfu's group tc-certs reaches the container (the certificate). As an argument, not
# GroupAdd=: Quadlet only knows that key from Podman 5 on (Ubuntu 24.04 has 4.9).
# nofile: about 1,216 descriptors for the fallback's connections at its defaults (the SFU warns below).
PodmanArgs=--memory={{ teamcraft_sfu_memory }} --group-add=keep-groups{{ (' --ulimit=nofile=' ~ teamcraft_sfu_nofile ~ ':' ~ teamcraft_sfu_nofile) if teamcraft_sfu_nofile | int > 0 else '' }}
LogDriver=journald

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300

[Install]
WantedBy=default.target
