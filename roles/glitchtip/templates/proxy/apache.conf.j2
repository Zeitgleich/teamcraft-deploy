# Managed by Ansible (teamcraft-deploy, role glitchtip): GlitchTip behind Apache 2.4.
# /etc/apache2/sites-available/glitchtip.conf; a2enmod ssl proxy proxy_http headers;
# a2ensite glitchtip; apachectl configtest && systemctl reload apache2. Certificate: e.g. certbot.
<VirtualHost *:443>
    ServerName {{ glitchtip_hostname }}
    SSLEngine on
    SSLCertificateFile {{ teamcraft_proxy_certificate_path | default('/etc/letsencrypt/live/{host}/fullchain.pem') | replace('{host}', glitchtip_hostname) }}
    SSLCertificateKeyFile {{ teamcraft_proxy_certificate_key_path | default('/etc/letsencrypt/live/{host}/privkey.pem') | replace('{host}', glitchtip_hostname) }}

    {% filter indent(4) %}{% include 'proxy/_apache.j2' %}{% endfilter %}

</VirtualHost>
