# Managed by Ansible (teamcraft-deploy, role teamcraft_server). Runs rootless as tc-server.
[Unit]
Description=TeamCraft server (API, gateway)

[Container]
Image={{ teamcraft_server_image }}
Pull=missing
ContainerName=teamcraft-server
# Host network inside tc-server's user namespace; listens on loopback only (behind the
# reverse proxy).
Network=host
Volume=/home/tc-server/config/teamcraft.toml:/etc/teamcraft/teamcraft.toml:ro,Z
{% if teamcraft_server_web_enabled %}
Volume=/home/tc-server/web:/srv/teamcraft/web:ro,Z
{% endif %}
{% if teamcraft_server_brand_assets_src | length > 0 %}
Volume=/home/tc-server/brands:/etc/teamcraft/brands:ro,Z
{% endif %}
Environment=TEAMCRAFT_CONFIG=/etc/teamcraft/teamcraft.toml
# The image sets TEAMCRAFT_SERVER__LISTEN_ADDR=[::]:8080, and the environment wins over the file:
# override it, or the server listens on every address of the host (host network), unproxied.
Environment=TEAMCRAFT_SERVER__LISTEN_ADDR={{ teamcraft_upstream_host }}:{{ teamcraft_ports.server }}
Environment=NO_COLOR=1
Secret=database_url,type=env,target=TEAMCRAFT_DATABASE__URL
Secret=s3_access_key,type=env,target=TEAMCRAFT_STORAGE__ACCESS_KEY
Secret=s3_secret_key,type=env,target=TEAMCRAFT_STORAGE__SECRET_KEY
Secret=sfu_registration_token,type=env,target=TEAMCRAFT_CALLS__SFU_REGISTRATION_TOKEN
Secret=meetings_guest_token_secret,type=env,target=TEAMCRAFT_MEETINGS__GUEST_TOKEN_SECRET
Secret=call_signing_key,type=mount,target=/run/secrets/call-signing.pem,uid=65532,gid=65532,mode=0400
Secret=vapid_private_key,type=env,target=TEAMCRAFT_PUSH__VAPID_PRIVATE_KEY
Secret=settings_key,type=env,target=TEAMCRAFT_SECRETS__KEY
{% if teamcraft_server_secrets.push_gateway_key | length > 0 %}
Secret=push_gateway_key,type=env,target=TEAMCRAFT_PUSH__GATEWAY__KEY
{% endif %}
{% if teamcraft_server_secrets.oidc_sync_client_secret | length > 0 %}
Secret=oidc_sync_client_secret,type=env,target=TEAMCRAFT_OIDC__SYNC__CLIENT_SECRET
{% endif %}
{% if teamcraft_server_secrets.smtp_password | length > 0 %}
Secret=smtp_password,type=env,target=TEAMCRAFT_MEETINGS__SMTP__PASSWORD
Secret=smtp_password,type=env,target=TEAMCRAFT_MAIL__SMTP__PASSWORD
{% endif %}
{% if teamcraft_server_secrets.caldav_password | length > 0 %}
Secret=caldav_password,type=env,target=TEAMCRAFT_MEETINGS__CALDAV__PASSWORD
{% endif %}
User=65532
Group=65532
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
RunInit=yes
# Exec form (JSON): the distroless image has no shell for the string form.
HealthCmd=["/usr/local/bin/teamcraft-server", "healthcheck", "--ready"]
HealthInterval=30s
HealthStartPeriod=30s
PodmanArgs=--memory={{ teamcraft_server_memory }}
LogDriver=journald

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300

[Install]
WantedBy=default.target
