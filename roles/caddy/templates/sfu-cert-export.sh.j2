#!/bin/sh
# Managed by Ansible (teamcraft-deploy, role caddy). Runs as tc-proxy: copies the SFU certificate that Caddy
# obtained into the shared directory readable by group tc-certs.
set -eu
dir="/home/tc-proxy/caddy-data/caddy/certificates/{{ caddy_issuer_dirs[caddy_tls] }}/{{ teamcraft_sfu_hostname }}"
dest="{{ teamcraft_cert_dir }}"
[ -f "$dir/{{ teamcraft_sfu_hostname }}.crt" ] || exit 0
if cmp -s "$dir/{{ teamcraft_sfu_hostname }}.crt" "$dest/sfu.crt"; then exit 0; fi
install -m 0640 -g tc-certs "$dir/{{ teamcraft_sfu_hostname }}.crt" "$dest/sfu.crt.new"
install -m 0640 -g tc-certs "$dir/{{ teamcraft_sfu_hostname }}.key" "$dest/sfu.key.new"
mv "$dest/sfu.key.new" "$dest/sfu.key"
mv "$dest/sfu.crt.new" "$dest/sfu.crt"
