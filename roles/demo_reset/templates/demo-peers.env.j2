# Managed by Ansible (teamcraft-deploy, role demo_reset). Settings of demo-peers and demo-seed (no
# secrets: the passwords come through with-dev-token-passwords).
E2E_DEPLOYED_URL=https://{{ teamcraft_domain }}
DEV_TOKEN_ISSUER={{ teamcraft_oidc_issuer }}
DEV_TOKEN_SCOPES="{{ teamcraft_oidc_app_scopes | difference(['offline_access']) | join(' ') }}"
DEV_TOKEN_SCRIPT=/usr/local/lib/teamcraft-demo/dev-token.py
DEMO_PEER_STORES={{ demo_peers_stores_dir }}
DEMO_LOGIN_SUFFIX={{ demo_peers_login_suffix }}
